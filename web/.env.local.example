# Copy to .env.local and fill in from your Supabase project settings.
# All three are safe to expose to the browser: the anon key is restricted by
# RLS, and the room id is the shared secret you hand out with the link.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_ROOM_ID=00000000-0000-0000-0000-000000000000
